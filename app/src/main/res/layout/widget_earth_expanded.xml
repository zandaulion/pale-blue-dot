<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_globe" android:layout_width="match_parent" android:layout_height="match_parent"
        android:contentDescription="@string/widget_globe_description" android:scaleType="centerCrop" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_overlay_scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="sans-serif-medium"
                android:text="@string/widget_title" android:textColor="#FFF4F8FC" android:textSize="16sp" />
            <ImageView android:id="@+id/widget_configure" android:layout_width="32dp" android:layout_height="32dp"
                android:background="@drawable/widget_action_background" android:contentDescription="@string/widget_change_place"
                android:padding="7dp" android:src="@drawable/ic_widget_settings" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/widget_place" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1"
            android:textColor="#FFF4F8FC" android:textSize="15sp" />
        <TextView android:id="@+id/widget_daylight" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:maxLines="1" android:textColor="#FFACDAEA" android:textSize="12sp" />
        <TextView android:id="@+id/widget_moon" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="#FFE8F1F8" android:textSize="13sp" />
        <LinearLayout android:id="@+id/widget_event_card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:background="@drawable/widget_event_background"
            android:orientation="vertical" android:paddingHorizontal="11dp" android:paddingVertical="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:letterSpacing="0.1"
                android:text="@string/widget_event_label" android:textAllCaps="true"
                android:textColor="#FFACDAEA" android:textSize="10sp" />
            <TextView android:id="@+id/widget_event" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:maxLines="2" android:textColor="#FFF4F8FC" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="end" android:maxLines="1"
            android:textColor="#FFA9C0D2" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
