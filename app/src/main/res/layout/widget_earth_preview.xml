<?xml version="1.0" encoding="utf-8"?>
<!-- Static 3 × 2 picker preview of the full-bleed compact widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:clipToOutline="true">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:contentDescription="@string/widget_globe_description"
        android:scaleType="centerCrop" android:src="@drawable/wallpaper_thumbnail" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/widget_overlay_scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="sans-serif-medium"
                android:text="@string/widget_title" android:textColor="#FFF4F8FC" android:textSize="14sp" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/widget_action_background"
                android:contentDescription="@string/widget_change_place"
                android:padding="5dp" android:src="@drawable/ic_widget_settings" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1"
            android:text="@string/widget_preview_place" android:textColor="#FFF4F8FC" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="@string/widget_preview_daylight"
            android:textColor="#FFACDAEA" android:textSize="11sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
            android:text="@string/widget_preview_moon" android:textColor="#FFE8F1F8" android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
