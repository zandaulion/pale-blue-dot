<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview (Android 12+). Mirrors widget_earth_expanded with sample text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_title" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <ImageView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="72dp" android:layout_marginTop="6dp"
        android:src="@drawable/wallpaper_thumbnail" android:scaleType="centerCrop"
        android:contentDescription="@string/widget_globe_description" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="@string/widget_preview_moon" android:textColor="#FFD3EAFB" android:textSize="14sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_preview_place" android:textColor="#FFFFFFFF" android:textSize="13sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_preview_event" android:textColor="#FFD3EAFB" android:textSize="12sp" />
</LinearLayout>
